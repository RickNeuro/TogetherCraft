# Copy this file to .env and replace the CHANGE_ME values before startup.
# Create a Microsoft app registration for personal Microsoft accounts and add this callback URI:
# https://YOUR_DOMAIN/signin-microsoft-minecraft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
POSTGRES_PASSWORD=CHANGE_ME_USE_64_HEX_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Fabric Minecraft server: external Playit address used for Server List Ping.
MC_SERVER_HOST=fried-newer.tun.ply.gg
MC_SERVER_PORT=32219
MC_SERVER_PROTOCOL=776
MC_SERVER_DISPLAY_ADDRESS=fried-newer.tun.ply.gg

# Create Minecraft server: TogetherCraft web container checks the local Ubuntu port.
# The public address is shown separately on the website.
MC_CREATE_SERVER_HOST=host.docker.internal
MC_CREATE_SERVER_PORT=25566
MC_CREATE_SERVER_PROTOCOL=767
MC_CREATE_SERVER_DISPLAY_ADDRESS=shrimp-crafts.tun.ply.gg

# RCON: keep both ports reachable only from trusted local Docker networks.
RCON_HOST=host.docker.internal
RCON_PORT=25575
RCON_PASSWORD=

RCON_CREATE_HOST=host.docker.internal
RCON_CREATE_PORT=25576
RCON_CREATE_PASSWORD=

# Needed only for public HTTPS mode.
PUBLIC_DOMAIN=CHANGE_ME.example.com