# Copy this file to .env and replace EVERY value marked CHANGE_ME before startup.
# For safe values on Ubuntu, generate hexadecimal secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_USE_64_HEX_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# RCON is disabled until you configure the same password in Minecraft server.properties.
# Never forward TCP 25575 from the router to the internet.
RCON_HOST=host.docker.internal
RCON_PORT=25575
RCON_PASSWORD=

# Needed only for public HTTPS mode: set a real DNS name pointed at this server.
PUBLIC_DOMAIN=CHANGE_ME.example.com
