@model TogetherCraft.Models.LoginViewModel
@{ ViewData["Title"] = "Вход"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-12 col-md-7 col-lg-5"><div class="card"><div class="card-body p-4 p-md-5">
    <a asp-controller="Home" asp-action="Index" class="small">← На главную</a>
    <h1 class="h2 mt-3">Вход в аккаунт</h1><p class="text-secondary">Войди, чтобы проверить заявку или открыть мониторинг.</p>
    @if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <form asp-controller="Account" asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="mb-3"><label asp-for="Username" class="form-label">Логин</label><input asp-for="Username" class="form-control" autocomplete="username" placeholder="Твой логин" /><span asp-validation-for="Username" class="field-validation-error small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Пароль</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Введи пароль" /><span asp-validation-for="Password" class="field-validation-error small"></span></div>
        <button class="btn btn-success w-100" type="submit">Войти</button>
    </form>
    <p class="text-secondary mt-4 mb-0">Ещё нет аккаунта? <a asp-controller="Account" asp-action="Register">Оставить заявку</a></p>
</div></div></div></div></div>
