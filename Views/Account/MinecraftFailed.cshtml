@{ ViewData["Title"] = "Не удалось подключить Minecraft"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-12 col-lg-7"><div class="card"><div class="card-body p-4 p-md-5">
    <h1 class="h2">Не удалось подтвердить профиль</h1>
    <p class="text-secondary">Microsoft или Xbox Live не завершили проверку. Убедись, что используешь аккаунт с Minecraft Java Edition, и попробуй снова.</p>
    <a class="btn btn-warning" asp-controller="Account" asp-action="ConnectMinecraft">Попробовать ещё раз</a>
</div></div></div></div></div>