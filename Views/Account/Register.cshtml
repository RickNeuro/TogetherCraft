@model TogetherCraft.Models.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<div class="container py-5"><div class="row justify-content-center"><div class="col-12 col-md-8 col-lg-6"><div class="card"><div class="card-body p-4 p-md-5">
    <a asp-controller="Home" asp-action="Index" class="small">← На главную</a>
    <h1 class="h2 mt-3">Создать аккаунт</h1><p class="text-secondary">Укажи логин и Minecraft-ник. После регистрации дождись одобрения администратора.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <form asp-controller="Account" asp-action="Register" method="post">
        <div class="mb-3"><label asp-for="Username" class="form-label">Логин</label><input asp-for="Username" class="form-control" autocomplete="username" placeholder="Придумай логин" /><span asp-validation-for="Username" class="field-validation-error small"></span></div>
        <div class="mb-3"><label asp-for="MinecraftUsername" class="form-label">Ник в Minecraft</label><input asp-for="MinecraftUsername" class="form-control" autocomplete="off" placeholder="Например, Steve_21" /><span asp-validation-for="MinecraftUsername" class="field-validation-error small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Пароль</label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="Не менее 10 символов" /><span asp-validation-for="Password" class="field-validation-error small"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Повтори пароль</label><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Введи пароль ещё раз" /><span asp-validation-for="ConfirmPassword" class="field-validation-error small"></span></div>
        <button class="btn btn-warning w-100" type="submit">Отправить заявку</button>
    </form>
    <p class="text-secondary mt-4 mb-0">Уже есть аккаунт? <a asp-controller="Account" asp-action="Login">Войти</a></p>
</div></div></div></div></div>
