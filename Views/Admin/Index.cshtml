@model IReadOnlyList<TogetherCraft.Models.UserAccount>
@{ ViewData["Title"] = "Заявки"; }
<div class="wrap internal-page admin-page py-5">
    <header class="internal-page-header admin-page-header">
        <div>
            <p class="section-label">ПАНЕЛЬ АДМИНИСТРАТОРА</p>
            <h1>Заявки на доступ</h1>
            <p class="internal-page-lead">Проверь Minecraft-профиль и выбранные игровые миры каждого участника.</p>
        </div>
        <div class="admin-count"><strong>@Model.Count</strong><span>заявок</span></div>
    </header>

    @if (Model.Count == 0)
    {
        <section class="empty-state-panel">
            <span class="empty-state-mark" aria-hidden="true">—</span>
            <h2>Новых заявок нет</h2>
            <p>Новые заявки появятся здесь после регистрации участников.</p>
        </section>
    }
    else
    {
        <section class="admin-table-panel">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 admin-applications-table">
                    <thead>
                        <tr>
                            <th>Аккаунт</th>
                            <th>Minecraft Java</th>
                            <th>Игровые миры</th>
                            <th>Дата</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in Model)
                    {
                        <tr>
                            <td>
                                <strong>@account.Username</strong>
                                @if (!string.IsNullOrWhiteSpace(account.Email))
                                {
                                    <div class="small text-secondary">@account.Email</div>
                                }
                            </td>
                            <td>
                                @if (account.MinecraftUuid is Guid uuid && !string.IsNullOrWhiteSpace(account.MinecraftUsername))
                                {
                                    <strong>@account.MinecraftUsername</strong>
                                    <div class="small text-secondary">@uuid</div>
                                }
                                else
                                {
                                    <span class="text-warning">Не подтверждён</span>
                                }
                            </td>
                            <td>
                                @if (account.WantsFabric)
                                {
                                    <span class="world-access-tag world-access-tag-vanilla">Vanilla</span>
                                }
                                @if (account.WantsCreate)
                                {
                                    <span class="world-access-tag world-access-tag-create">Create</span>
                                }
                            </td>
                            <td>@account.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="admin-row-actions">
                                    <form asp-controller="Admin" asp-action="Approve" method="post">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <button class="tc-btn tc-btn-primary" type="submit" disabled="@(account.MinecraftUuid is null)">Одобрить</button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="Reject" method="post" onsubmit="return confirm('Отклонить заявку @account.Username?');">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <button class="tc-btn tc-btn-secondary tc-btn-danger" type="submit">Отклонить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
