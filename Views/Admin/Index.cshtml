@model IReadOnlyList<TogetherCraft.Models.UserAccount>
@{ ViewData["Title"] = "Заявки"; }
<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
        <div><p class="text-warning text-uppercase small fw-semibold mb-1">Панель администратора</p><h1 class="h2">Заявки на доступ</h1><p class="text-secondary mb-0">Проверь Minecraft-профиль и выбранные игровые миры.</p></div>
        <div><span class="badge text-bg-secondary fs-6">@Model.Count заявок</span></div>
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (Model.Count == 0)
    {
        <div class="card"><div class="card-body py-5 text-center"><h2 class="h5">Новых заявок нет</h2><p class="text-secondary mb-0">Новые заявки появятся здесь после регистрации.</p></div></div>
    }
    else
    {
        <div class="card"><div class="table-responsive"><table class="table table-dark table-hover align-middle mb-0">
            <thead><tr><th>Аккаунт</th><th>Minecraft Java</th><th>Игровые миры</th><th>Дата</th><th class="text-end">Действия</th></tr></thead>
            <tbody>
            @foreach (var account in Model)
            {
                <tr>
                    <td><strong>@account.Username</strong><div class="small text-secondary">@account.Email</div></td>
                    <td>
                        @if (account.MinecraftUuid is Guid uuid && !string.IsNullOrWhiteSpace(account.MinecraftUsername))
                        {
                            <strong>@account.MinecraftUsername</strong><div class="small text-secondary">@uuid</div>
                        }
                        else
                        {
                            <span class="text-warning">Не подтверждён</span>
                        }
                    </td>
                    <td>
                        @if (account.WantsFabric) { <span class="badge text-bg-secondary me-1">Fabric</span> }
                        @if (account.WantsCreate) { <span class="badge text-bg-secondary">Create</span> }
                    </td>
                    <td>@account.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><div class="d-flex flex-wrap justify-content-end gap-2">
                        <form asp-controller="Admin" asp-action="Approve" method="post">
                            <input type="hidden" name="id" value="@account.Id" />
                            <button class="btn btn-warning btn-sm" type="submit" disabled="@(account.MinecraftUuid is null)">Одобрить</button>
                        </form>
                        <form asp-controller="Admin" asp-action="Reject" method="post" onsubmit="return confirm('Отклонить заявку @account.Username?');">
                            <input type="hidden" name="id" value="@account.Id" />
                            <button class="btn btn-outline-danger btn-sm" type="submit">Отклонить</button>
                        </form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table></div></div>
    }
</div>