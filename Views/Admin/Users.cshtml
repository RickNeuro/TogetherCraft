@model IReadOnlyList<TogetherCraft.Models.AdminUserViewModel>
@{
    ViewData["Title"] = "Пользователи";
}
<div class="wrap py-4">
    <div class="mb-4">
        <p class="section-label">ПАНЕЛЬ АДМИНИСТРАТОРА</p>
        <h1 class="display-6 fw-bold">Пользователи</h1>
        <p class="text-secondary">Здесь можно назначать доверенных участников администраторами и снимать административную роль.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="site-alert site-alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="site-alert site-alert-error" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="world-card"><div class="world-content"><h2 class="h5">Пользователей пока нет</h2></div></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Аккаунт</th>
                        <th>Minecraft</th>
                        <th>Статус</th>
                        <th>Роль</th>
                        <th class="text-end">Действие</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <strong>@user.Username</strong>
                            @if (!string.IsNullOrWhiteSpace(user.Email))
                            {
                                <div class="small text-secondary">@user.Email</div>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(user.MinecraftUsername) ? "Не привязан" : user.MinecraftUsername)</td>
                        <td>@user.Status</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge text-bg-warning">Администратор</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Участник</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (user.Role == "Admin")
                            {
                                <form asp-controller="Admin" asp-action="SetRole" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="role" value="User" />
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Снять Admin</button>
                                </form>
                            }
                            else if (user.Status != "Rejected")
                            {
                                <form asp-controller="Admin" asp-action="SetRole" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="role" value="Admin" />
                                    <button class="btn btn-warning btn-sm" type="submit">Назначить Admin</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
