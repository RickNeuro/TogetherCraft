@{
    ViewData["Title"] = "Главная";
}
<div class="wrap home-page" id="tc-landing">
    <section class="hero" id="home">
        <div class="hero-copy-block">
            <p class="eyebrow"><span class="eyebrow-mark"></span> ИГРОВОЕ СООБЩЕСТВО</p>
            <h1>Выбирай своё<br /><span>приключение</span></h1>
            <p class="hero-copy">Три разных мира, одна идея — играть, строить и создавать вместе. От спокойного выживания до сложных механизмов и огромных фабрик.</p>
            <div class="hero-actions">
                <a class="tc-btn tc-btn-primary" asp-controller="Home" asp-action="Worlds">Выбрать мир</a>
                <a class="tc-btn tc-btn-secondary" asp-controller="Home" asp-action="Team">О сообществе</a>
            </div>
        </div>
        <img class="hero-image hero-image-light" src="/img/hero-night.webp?v=4" alt="Ночная обложка TogetherCraft" />
        <img class="hero-image hero-image-dark" src="/img/hero-night.webp?v=4" alt="Ночная обложка TogetherCraft" fetchpriority="high" />
    </section>

    <section class="home-worlds-preview">
        <div class="section-head">
            <div><div class="section-label">ВО ЧТО ИГРАЕМ</div><h2>Три мира. Выбирай свой.</h2></div>
            <a class="section-more-link" asp-controller="Home" asp-action="Worlds">Все игровые миры</a>
        </div>
        <div class="home-worlds-strip">
            <div><span class="home-world-icon"><img src="/img/game-assets/mossy-cobblestone.png" alt="Замшелый булыжник Minecraft" loading="lazy" /></span><span><strong>Minecraft · Vanilla</strong><small>Классическое выживание</small></span></div>
            <div><span class="home-world-icon home-world-icon-gear"><img src="/img/game-assets/create-large-cogwheel.webp" alt="Шестерня Create" loading="lazy" /></span><span><strong>Minecraft · Create</strong><small>Механизмы и инженерия</small></span></div>
            <div><span class="home-world-icon home-world-icon-biter"><img src="/img/game-assets/big-biter.png" alt="Кусак Factorio" loading="lazy" /></span><span><strong>Factorio</strong><small>Фабрики и автоматизация</small></span></div>
        </div>
    </section>

    <section class="home-gallery-preview">
        <div>
            <div class="section-label">ИЗ ЖИЗНИ СООБЩЕСТВА</div>
            <h2>Постройки, механизмы и проекты.</h2>
        </div>
        <a class="world-action" asp-controller="Home" asp-action="Gallery">Открыть галерею</a>
    </section>
</div>
