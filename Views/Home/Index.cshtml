@{
    ViewData["Title"] = "Главная";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var isPending = isAuthenticated && User.HasClaim("access_status", "Pending");
    var canPlay = isAdmin || (isAuthenticated && User.HasClaim("access_status", "Approved"));
}
<div class="wrap">
    <section class="hero" id="about">
        <div class="hero-copy-block">
            <p class="eyebrow">Minecraft · Factorio · совместная игра</p>
            <h1>Играем вместе. Создаём больше.</h1>
            <p class="hero-copy">Строим миры, исследуем неизведанное и автоматизируем производство. TogetherCraft объединяет разные игровые проекты и людей, которым интересно создавать что-то вместе.</p>
            <div class="hero-actions" id="apply">
                @if (!isAuthenticated)
                {
                    <a class="tc-btn tc-btn-primary" asp-controller="Account" asp-action="Register">Стать участником</a>
                    <a class="tc-btn" asp-controller="Account" asp-action="Login">Войти</a>
                }
                else if (isAdmin)
                {
                    <a class="tc-btn tc-btn-primary" asp-controller="Home" asp-action="Play">Адреса игровых миров</a>
                    <a class="tc-btn" asp-controller="Admin" asp-action="Index">Заявки</a>
                }
                else if (isPending)
                {
                    <a class="tc-btn tc-btn-primary" asp-controller="Account" asp-action="Waiting">Моя заявка</a>
                }
                else if (canPlay)
                {
                    <a class="tc-btn tc-btn-primary" asp-controller="Home" asp-action="Play">Адреса игровых миров</a>
                }
            </div>
        </div>
        <img class="hero-image" src="~/img/hero-fox.jpg" alt="Лиса в мире Minecraft на закате" />
    </section>

    <section class="worlds-section" id="worlds">
        <div class="section-head">
            <div>
                <div class="section-label">Игровые направления</div>
                <h2>Выбирай свой мир</h2>
            </div>
            <p class="section-desc">Разные игры — одно сообщество.</p>
        </div>

        <div class="world-grid">
            <article class="world-card">
                <div class="world-art world-art-fabric" role="img" aria-label="Иллюстрация мира Minecraft Fabric">
                    <span class="world-art-label">MINECRAFT</span>
                    <span class="world-art-number">01</span>
                </div>
                <div class="world-content">
                    <span class="world-kicker">ВЫЖИВАНИЕ И ИССЛЕДОВАНИЕ</span>
                    <h3>Minecraft · Fabric</h3>
                    <p>Совместное выживание, строительство, исследование мира и собственные проекты.</p>
                    <span class="world-detail">Основной игровой мир</span>
                </div>
            </article>

            <article class="world-card">
                <div class="world-art world-art-create" role="img" aria-label="Иллюстрация мира Minecraft Create">
                    <span class="world-art-label">CREATE</span>
                    <span class="world-art-number">02</span>
                </div>
                <div class="world-content">
                    <span class="world-kicker">МЕХАНИЗМЫ И АВТОМАТИЗАЦИЯ</span>
                    <h3>Minecraft · Create</h3>
                    <p>Механизмы, поезда, производственные цепочки и большие инженерные проекты.</p>
                    <span class="world-detail">Технический игровой мир</span>
                </div>
            </article>

            <article class="world-card">
                <div class="world-art world-art-factorio" role="img" aria-label="Иллюстрация Factorio">
                    <span class="world-art-label">FACTORIO</span>
                    <span class="world-art-number">03</span>
                </div>
                <div class="world-content">
                    <span class="world-kicker">ФАБРИКИ И ЛОГИСТИКА</span>
                    <h3>Factorio</h3>
                    <p>Развиваем производство, строим конвейерные сети и вместе оптимизируем фабрики.</p>
                    <span class="world-detail">Новое направление TogetherCraft</span>
                </div>
            </article>
        </div>
        <p class="worlds-access-note">Адреса подключения доступны только после одобрения заявки.</p>
    </section>

    <section class="faq" id="faq">
        <div class="section-label">FAQ</div>
        <h2>Частые вопросы</h2>
        <p class="faq-intro">Коротко о том, как устроен TogetherCraft.</p>
        <div class="faq-list">
            <details open>
                <summary>Как попасть в сообщество?</summary>
                <div class="faq-answer">Создай аккаунт, подтверди профиль Minecraft через Microsoft и отправь заявку. После проверки администратор откроет доступ к выбранным игровым мирам.</div>
            </details>
            <details>
                <summary>Какие игровые направления есть?</summary>
                <div class="faq-answer">Сейчас доступны два направления Minecraft: Fabric и Create. Factorio — новое направление, которое мы готовим к запуску.</div>
            </details>
            <details>
                <summary>Когда я получу адреса подключения?</summary>
                <div class="faq-answer">После одобрения заявки адреса доступных игровых миров появятся в личном разделе «Подключение».</div>
            </details>
            <details>
                <summary>Можно ли строить собственные проекты?</summary>
                <div class="faq-answer">Да. TogetherCraft создан для совместной игры: можно строить, исследовать, объединяться в команды и развивать общие проекты.</div>
            </details>
        </div>
    </section>
</div>
