@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Главная";
    var registrationEnabled = !string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientId"]) && !string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientSecret"]);
    var signedIn = User.Identity?.IsAuthenticated == true;
    var pending = signedIn && User.HasClaim("access_status", "Pending");
    var approved = signedIn && User.HasClaim("access_status", "Approved");
    var actionUrl = !signedIn ? Url.Action(registrationEnabled ? "Register" : "Login", "Account") : pending ? Url.Action("Waiting", "Account") : approved ? Url.Action("Play", "Home") : Url.Action("Login", "Account");
    var actionText = !signedIn ? (registrationEnabled ? "Присоединиться" : "Войти") : pending ? "Заявка на рассмотрении" : approved ? "Открыть игровые миры" : "Продолжить";
}
<div id="tc-landing">
    <section class="hero" id="home">
        <div class="hero-inner"><div class="hero-copy">
            <p class="hero-kicker">ИГРОВОЕ СООБЩЕСТВО</p>
            <h1>Выбирай своё<br /><span>приключение</span></h1>
            <p class="hero-description">TogetherCraft — место, где можно играть, строить и создавать вместе.</p>
            <div class="hero-actions">
                <a class="tc-button tc-button-primary" href="@actionUrl">@actionText <span aria-hidden="true">›</span></a>
                @if (approved) { <a class="tc-button tc-button-quiet" asp-controller="Home" asp-action="Play">Подключение</a> }
                else if (pending) { <a class="tc-button tc-button-quiet" asp-controller="Account" asp-action="Waiting">Моя заявка</a> }
            </div>
        </div></div>
    </section>
    <section class="world-grid" id="worlds" aria-label="Игровые направления">
        <a class="world-card" href="@actionUrl">
            <img class="world-photo" src="~/img/concept/world-fabric.webp" asp-append-version="true" alt="Minecraft Fabric" />
            <span class="world-content"><span class="world-title-line"><span class="world-icon world-icon-fabric">◆</span><strong>Minecraft · Fabric</strong></span><span class="world-description">Выживание, приключения и общие постройки.</span><span class="world-more">Подробнее <span aria-hidden="true">→</span></span></span>
        </a>
        <a class="world-card" href="@actionUrl">
            <img class="world-photo" src="~/img/concept/world-create.webp" asp-append-version="true" alt="Minecraft Create" />
            <span class="world-content"><span class="world-title-line"><span class="world-icon world-icon-create">⚙</span><strong>Minecraft · Create</strong></span><span class="world-description">Механизмы, инженерия и автоматизация.</span><span class="world-more">Подробнее <span aria-hidden="true">→</span></span></span>
        </a>
        <a class="world-card" href="@actionUrl">
            <img class="world-photo" src="~/img/concept/world-factorio.webp" asp-append-version="true" alt="Factorio" />
            <span class="world-content"><span class="world-title-line"><span class="world-icon world-icon-factorio">⬡</span><strong>Factorio</strong></span><span class="world-description">Строй фабрику, развивай производство вместе.</span><span class="world-more">Подробнее <span aria-hidden="true">→</span></span></span>
        </a>
    </section>
    <section class="support-grid">
        <article class="support-panel gallery-panel" id="gallery">
            <div class="panel-heading"><h2><span class="panel-icon">▧</span>Галерея</h2><a href="#worlds">Смотреть всё →</a></div>
            <div class="gallery-thumbs">
                <a href="#worlds"><img src="~/img/concept/gallery-1.webp" asp-append-version="true" alt="Постройки сообщества" loading="lazy" /></a>
                <a href="#worlds"><img src="~/img/concept/gallery-2.webp" asp-append-version="true" alt="Игровой мир" loading="lazy" /></a>
                <a href="#worlds"><img src="~/img/concept/gallery-3.webp" asp-append-version="true" alt="Совместное приключение" loading="lazy" /></a>
            </div>
        </article>
        <article class="support-panel team-panel" id="team">
            <div class="panel-heading"><h2><span class="panel-icon">♟</span>Наша команда</h2></div>
            <p>Люди, которые делают<br />эти миры общими.</p>
            <div class="team-avatars">
                <img src="~/img/concept/team-fox.webp" asp-append-version="true" alt="Участник сообщества" loading="lazy" />
                <img src="~/img/concept/team-dark.webp" asp-append-version="true" alt="Участник сообщества" loading="lazy" />
                <img src="~/img/concept/team-enderman.webp" asp-append-version="true" alt="Участник сообщества" loading="lazy" />
                <a href="https://discord.gg/V6RnZ59VCe" target="_blank" rel="noopener noreferrer" aria-label="Познакомиться с сообществом">+</a>
            </div>
        </article>
        <article class="support-panel faq-panel">
            <div class="panel-heading"><h2><span class="panel-icon">?</span>FAQ</h2></div>
            <p>Как вступить, как подключиться<br />и что происходит после заявки.</p>
            <a class="faq-button" href="#faq">Читать FAQ <span aria-hidden="true">→</span></a>
        </article>
    </section>
    <section class="faq-section" id="faq">
        <div class="faq-heading"><span>FAQ</span><h2>Частые вопросы</h2></div>
        <div class="faq-list">
            <details><summary>Как присоединиться к TogetherCraft?</summary><p>Создай аккаунт, выбери доступные игровые направления и подтверди Minecraft Java через Microsoft. После этого заявка попадёт администраторам на рассмотрение.</p></details>
            <details><summary>Зачем подтверждать Minecraft через Microsoft?</summary><p>Так мы проверяем, что Minecraft-профиль принадлежит тебе. Пароль вводится на официальном сайте Microsoft — TogetherCraft его не получает.</p></details>
            <details><summary>Когда появятся адреса серверов?</summary><p>После одобрения заявки раздел «Подключение» станет доступен в аккаунте.</p></details>
            <details><summary>Можно ли присоединиться не ко всем мирам?</summary><p>Да. При регистрации можно выбрать поддерживаемые игровые направления. Factorio пока представлен на сайте как направление сообщества, его подключение будет добавлено отдельно.</p></details>
        </div>
    </section>
</div>