@model TogetherCraft.Models.PlayViewModel
@{
    ViewData["Title"] = "Подключение";
}
<div class="wrap internal-page worlds-hub-page py-5">
    <header class="internal-page-header">
        <div>
            <p class="section-label">ТВОИ ИГРОВЫЕ МИРЫ</p>
            <h1>Подключение</h1>
            <p class="internal-page-lead">Привет, @Model.Username. Выбери отдельный сервер — у каждого свой мир, правила и стиль игры.</p>
        </div>
    </header>

    @if (!Model.CanAccessVanilla && !Model.CanAccessCreate)
    {
        <section class="empty-state-panel">
            <h2>Пока нет доступных серверов</h2>
            <p>Проверь выбранные игровые направления или обратись к администратору.</p>
        </section>
    }
    else
    {
        <div class="server-choice-grid">
            @if (Model.CanAccessVanilla)
            {
                <a class="server-choice server-choice-vanilla" asp-controller="Home" asp-action="Vanilla">
                    <div class="server-choice-art">
                        <span>SERVER 01</span>
                        <strong class="server-choice-symbol" aria-hidden="true">◆</strong>
                        <small>CLASSIC SURVIVAL</small>
                    </div>
                    <div class="server-choice-content">
                        <span class="world-kicker">MINECRAFT · VANILLA</span>
                        <h2>Классическое выживание</h2>
                        <p>Исследование, строительство и совместная игра. Отдельный мир без Create-механик.</p>
                        <span class="server-choice-link">Открыть Vanilla <b aria-hidden="true">→</b></span>
                    </div>
                </a>
            }

            @if (Model.CanAccessCreate)
            {
                <a class="server-choice server-choice-create" asp-controller="Home" asp-action="Create">
                    <div class="server-choice-art">
                        <span>SERVER 02</span>
                        <strong class="server-choice-symbol" aria-hidden="true">⚙</strong>
                        <small>ENGINEERING & AUTOMATION</small>
                    </div>
                    <div class="server-choice-content">
                        <span class="world-kicker">MINECRAFT · CREATE</span>
                        <h2>Механизмы и автоматизация</h2>
                        <p>Отдельный технический мир с шестернями, поездами, фабриками и механизмами Create.</p>
                        <span class="server-choice-link">Открыть Create <b aria-hidden="true">→</b></span>
                    </div>
                </a>
            }
        </div>
    }

    <p class="future-world-note"><strong>Factorio</strong> — отдельное направление сообщества. Подключение появится здесь после запуска.</p>
</div>
