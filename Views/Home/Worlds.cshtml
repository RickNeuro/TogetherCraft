@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Игровые миры";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var pending = signedIn && User.HasClaim("access_status", "Pending");
    var approved = signedIn && User.HasClaim("access_status", "Approved");
    var registrationEnabled = !string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientSecret"]);
    var vanillaActionUrl = !signedIn
        ? (registrationEnabled ? Url.Action("Register", "Account") : Url.Action("Login", "Account", new { returnUrl = Url.Action("Vanilla", "Home") }))
        : pending
            ? Url.Action("Waiting", "Account")
            : approved
                ? Url.Action("Vanilla", "Home")
                : Url.Action("Login", "Account");
    var createActionUrl = !signedIn
        ? (registrationEnabled ? Url.Action("Register", "Account") : Url.Action("Login", "Account", new { returnUrl = Url.Action("Create", "Home") }))
        : pending
            ? Url.Action("Waiting", "Account")
            : approved
                ? Url.Action("Create", "Home")
                : Url.Action("Login", "Account");
}
<section class="internal-page worlds-page">
    <header class="internal-page-header">
        <div>
            <div class="section-label">ВО ЧТО ИГРАЕМ</div>
            <h1>Игровые миры</h1>
            <p class="internal-page-lead">Три направления с разным настроением: классическое выживание, инженерия и большая промышленность.</p>
        </div>
    </header>

    <div class="world-grid">
        <article class="world-card world-card-fabric">
            <div class="world-art">
                <span class="world-art-number">01 / SURVIVAL</span>
                <span class="world-art-symbol world-symbol-block" aria-hidden="true">
                    <img src="/img/game-assets/mossy-cobblestone.png" alt="" loading="lazy" decoding="async" />
                </span>
            </div>
            <div class="world-content">
                <span class="world-kicker">MINECRAFT · VANILLA</span>
                <h2>Спокойное выживание</h2>
                <p>Исследуем мир, строим базы и создаём общие места, куда хочется возвращаться.</p>
                <a class="world-action" href="@vanillaActionUrl" data-page-transition>Исследовать мир <span aria-hidden="true">→</span></a>
            </div>
        </article>

        <article class="world-card world-card-create">
            <div class="world-art">
                <span class="world-art-number">02 / ENGINEERING</span>
                <span class="world-art-symbol world-symbol-gear" aria-hidden="true">
                    <img src="/img/game-assets/create-large-cogwheel.png" alt="" loading="lazy" decoding="async" />
                </span>
            </div>
            <div class="world-content">
                <span class="world-kicker">MINECRAFT · CREATE</span>
                <h2>Инженерия и механизмы</h2>
                <p>Проектируем машины, автоматизируем процессы и собираем большие технические проекты.</p>
                <a class="world-action" href="@createActionUrl" data-page-transition>Изучить механизмы <span aria-hidden="true">→</span></a>
            </div>
        </article>

        <article class="world-card world-card-factorio">
            <div class="world-art">
                <span class="world-art-number">03 / INDUSTRY</span>
                <span class="world-art-symbol world-symbol-factory" aria-hidden="true">
                    <img src="/img/game-assets/factorio-logo.png" alt="" loading="lazy" decoding="async" />
                </span>
            </div>
            <div class="world-content">
                <span class="world-kicker">FACTORIO</span>
                <h2>Фабрика растёт</h2>
                <p>Добываем ресурсы, связываем производство и превращаем хаос в работающую систему.</p>
                <span class="world-action world-action-disabled" aria-disabled="true">Скоро</span>
            </div>
        </article>
    </div>
</section>
