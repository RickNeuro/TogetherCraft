<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TogetherCraft</title>
    <meta name="description" content="TogetherCraft — приватный Minecraft-сервер для друзей." />
    <link rel="icon" type="image/svg+xml" href="~/img/cube.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><span class="brand-mark">T</span> TogetherCraft</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Открыть меню"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <div class="navbar-nav me-auto">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Server">Мониторинг</a>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">Заявки</a>
                    }
                </div>
                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 py-2 py-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-lg-2">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Выйти</button></form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Войти</a>
                        <a class="btn btn-success btn-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main>
        <div class="container pt-3">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
            }
        </div>
        @RenderBody()
    </main>
    <footer class="site-footer mt-5 py-4"><div class="container d-flex flex-column flex-md-row justify-content-between gap-2"><span><strong>TogetherCraft</strong> · Minecraft Fabric</span><span class="text-secondary">Приватный сервер для друзей</span></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
