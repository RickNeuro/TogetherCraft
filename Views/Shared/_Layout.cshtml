<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TogetherCraft</title>
    <meta name="description" content="TogetherCraft — Minecraft, Factorio и совместные игровые проекты." />
    <link rel="icon" type="image/svg+xml" href="~/img/cube.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home-v4.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-community.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-bs-theme="dark">
    <header class="topbar">
        <div class="wrap nav">
            <a class="brand" asp-controller="Home" asp-action="Index">TogetherCraft</a>
            <nav class="navlinks" aria-label="Главная навигация">
                <a asp-controller="Home" asp-action="Index">Главная</a>
                <a href="/#worlds">Игровые миры</a>
                <a href="/#faq">FAQ</a>
                @if (User.Identity?.IsAuthenticated == true && User.HasClaim("access_status", "Approved"))
                {
                    <a asp-controller="Home" asp-action="Play">Подключение</a>
                }
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <a asp-controller="Home" asp-action="Server">Мониторинг</a>
                    <a asp-controller="Admin" asp-action="Index">Заявки</a>
                    <a asp-controller="Admin" asp-action="Users">Пользователи</a>
                }
            </nav>
            <div class="spacer"></div>
            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout">
                        <button class="nav-link-button" type="submit">Выйти</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Войти</a>
                    <a class="cta" asp-controller="Account" asp-action="Register">Регистрация</a>
                }
            </div>
        </div>
    </header>
    <main id="top">
        <div class="wrap">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="site-alert site-alert-success" role="status">@successMessage</div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="site-alert site-alert-error" role="alert">@errorMessage</div>
            }
        </div>
        @RenderBody()
    </main>
    <footer class="footer" id="community">
        <div class="wrap">
            <div class="footer-main">
                <div class="footer-brand"><strong>TogetherCraft</strong><span>Вместе играем. Вместе строим.</span></div>
                <div class="footer-social">
                    <span class="social-caption">СООБЩЕСТВО</span>
                    <a class="social-link" href="https://discord.gg/V6RnZ59VCe" target="_blank" rel="noopener noreferrer" aria-label="Discord TogetherCraft" title="Discord TogetherCraft">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.7 5.2A18.3 18.3 0 0 0 15.2 3.8l-.5 1a16.8 16.8 0 0 0-5.4 0l-.5-1a18.4 18.4 0 0 0-4.5 1.4C1.5 9.4.7 13.5 1.1 17.5a18.5 18.5 0 0 0 5.5 2.8l1.2-2a11.8 11.8 0 0 1-1.9-.9l.5-.4c3.7 1.7 7.7 1.7 11.4 0l.5.4a12 12 0 0 1-1.9.9l1.2 2a18.4 18.4 0 0 0 5.5-2.8c.5-4.7-.8-8.8-3.4-12.3ZM8.6 14.9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2Zm6.8 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2Z" /></svg>
                    </a>
                    <a class="social-link" href="https://github.com/RickNeuro/TogetherCraft" target="_blank" rel="noopener noreferrer" aria-label="GitHub TogetherCraft" title="GitHub TogetherCraft">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.5v-2c-3.3.7-4-1.4-4-1.4-.5-1.3-1.3-1.6-1.3-1.6-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1 .8 2v3c0 .3.2.6.8.5A11.1 11.1 0 0 0 12 .9Z" /></svg>
                    </a>
                </div>
            </div>
            <div class="footer-bottom"><span>© TogetherCraft · Minecraft + Factorio</span><span>Игровые адреса доступны одобренным участникам</span></div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
