@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TogetherCraft</title>
    <meta name="description" content="TogetherCraft — Minecraft, Factorio и совместные игровые проекты." />
    <meta name="theme-color" content="#232628" />
    <link rel="icon" type="image/png" href="https://static.wikia.nocookie.net/minecraft_gamepedia/images/8/88/FoxFace.png/revision/latest?cb=20190213180659" sizes="32x32" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home-v4.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-community.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell" data-bs-theme="dark">
    <header class="topbar">
        <div class="wrap nav">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="TogetherCraft — главная">
                <img src="https://static.wikia.nocookie.net/minecraft_gamepedia/images/8/88/FoxFace.png/revision/latest?cb=20190213180659" alt="Лиса Minecraft" referrerpolicy="no-referrer" />
                <span>Together<strong>Craft</strong></span>
            </a>

            <nav class="navlinks" aria-label="Главная навигация">
                <a asp-controller="Home" asp-action="Index" class="@(currentAction == "Index" ? "active" : "")">Главная</a>
                <a asp-controller="Home" asp-action="Worlds" class="@(currentAction == "Worlds" ? "active" : "")">Игровые миры</a>
                <a asp-controller="Home" asp-action="Gallery" class="@(currentAction == "Gallery" ? "active" : "")">Галерея</a>
                <a asp-controller="Home" asp-action="Team" class="@(currentAction == "Team" ? "active" : "")">Команда</a>
                <a asp-controller="Home" asp-action="Faq" class="@(currentAction == "Faq" ? "active" : "")">FAQ</a>
                @if (User.Identity?.IsAuthenticated == true && User.HasClaim("access_status", "Approved"))
                {
                    <a asp-controller="Home" asp-action="Play" class="@(currentAction == "Play" ? "active" : "")">Подключение</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index">Админка</a>
                    <a asp-controller="Home" asp-action="Server">Мониторинг</a>
                }
            </nav>

            <div class="spacer"></div>
            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout">
                        <button class="nav-link-button" type="submit">Выйти</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Войти</a>
                    @if (!string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientId"]) && !string.IsNullOrWhiteSpace(Configuration["MicrosoftMinecraft:ClientSecret"]))
                    {
                        <a class="cta" asp-controller="Account" asp-action="Register">Присоединиться ↗</a>
                    }
                }
            </div>
        </div>
    </header>

    <main id="top" class="site-main">
        <div class="wrap">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="site-alert site-alert-success" role="status">@successMessage</div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="site-alert site-alert-error" role="alert">@errorMessage</div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="footer" id="community">
        <div class="wrap">
            <div class="footer-main">
                <div class="footer-brand footer-brand-line">
                    <img src="https://static.wikia.nocookie.net/minecraft_gamepedia/images/8/88/FoxFace.png/revision/latest?cb=20190213180659" alt="" referrerpolicy="no-referrer" />
                    <div>
                        <strong>TogetherCraft</strong>
                        <span>Вместе играем. Вместе строим.</span>
                    </div>
                </div>
                <div class="footer-social">
                    <a href="https://discord.gg/V6RnZ59VCe" target="_blank" rel="noopener noreferrer">Discord ↗</a>
                    <a href="https://github.com/RickNeuro/TogetherCraft" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© TogetherCraft · Minecraft + Factorio</span>
                <span>Игровые адреса доступны одобренным участникам</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
